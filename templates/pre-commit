#!/usr/bin/env bash
# Pre-commit hook: regenerate sitemap when source files change.
# Install: cp templates/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Or with Husky: copy to .husky/pre-commit

set -e

# Load nvm if available (so node/npm are accessible in hook context)
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  # shellcheck disable=SC1091
  . "$NVM_DIR/nvm.sh"
  nvm use --silent 2>/dev/null || true
fi

# Check if any source files changed that would affect the build
CHANGED=$(git diff --cached --name-only 2>/dev/null || true)

if echo "$CHANGED" | grep -qE '^(src/|public/|index\.html)'; then
  echo "Source files changed — rebuilding..."
  npm run build

  # Stage any updated build artifacts you want to include in the commit
  # Adjust the path below to match your project's output directory
  # git add dist/ public/sitemap.xml .sitemap-cache.json
fi
